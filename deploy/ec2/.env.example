# Copy to `.env` in this folder (deploy/ec2) on the EC2 host and fill in real values.
# NON-SECRET config only. Secrets live in AWS Secrets Manager (ardhana/prod) and are fetched by
# fetch-secrets.sh. See README.md.

# Full scheme+host the app is served at (no trailing slash). Baked into the web build (API URL) and
# used as the API's CORS origin and FRONTEND_URL (login links in emails). Must match ardhana.caddy.
PUBLIC_URL=https://ardhana.in

# Optional override. Default: PUBLIC_URL plus https://localhost (the Android app's WebView origin).
# CORS_ALLOWED_ORIGINS=https://ardhana.in,https://localhost

# Database + user inside Kettlio's MySQL (created by init-db.sh).
DB_NAME=ardhana
DB_USER=ardhana

# Kettlio's Docker network (its compose project folder is `ketlio`).
SHARED_NETWORK=ketlio_default

# Where the dear-digital-space repo is cloned, relative to this folder.
WEB_SRC_DIR=../../../dear-digital-space
